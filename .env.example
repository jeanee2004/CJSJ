# 공공데이터포털 Decoding 키 (실거래가, 건축HUB, 마이홈, 행안부, 복지로 공통)
DATA_GO_KR_KEY=
# 온통청년 인증키
YOUTHCENTER_KEY=
# 한국부동산원 R-ONE 인증키
RONE_KEY=

# 관리자 대시보드 의견 AI 요약 (Google AI Studio 키, 서버 전용 — Vercel 환경변수에도 등록)
GEMINI_API_KEY=

# 회원가입(/api/signup)·계정 삭제·리포트 메일(서버 전용 — Vercel 환경변수에 등록)
SUPABASE_SECRET_KEY=
# 결과 리포트 메일 발송 (Resend, https://resend.com — 서버 전용). 없으면 리포트 메일 버튼이 "준비되지 않았어요"로 응답한다
RESEND_API_KEY=
# 보내는 사람. Resend 에서 인증한 도메인 주소여야 아무에게나 보낼 수 있다 (기본값 onboarding@resend.dev 는 Resend 계정 주인에게만 발송됨)
REPORT_FROM=
# 메일 속 "결과 다시 보기" 링크 주소 (기본값 https://cjsj-one.vercel.app)
SITE_URL=
